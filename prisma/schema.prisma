generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          String       @id
  email       String?      @unique
  fullName    String       @map("full_name")
  department  String?
  year        Int?
  phone       String?
  role        String       @default("student")
  rollNumber  String?      @map("roll_number")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  memberships TeamMember[]
  assignments EvaluatorAssignment[]
  evaluations Evaluation[]

  @@index([email])
  @@index([role])
  @@map("profiles")
}

model Team {
  id               String       @id @default(uuid())
  name             String
  psNumber         String?      @map("ps_number")
  theme            String?
  techStack        String?      @map("tech_stack")
  businessSector   String?      @map("business_sector")
  problemStatement String?      @map("problem_statement")
  category         String?
  leaderId         String       @map("leader_id")
  status           String       @default("submitted")
  createdAt        DateTime     @default(now()) @map("created_at")

  members     TeamMember[]
  assignments EvaluatorAssignment[]
  evaluations Evaluation[]

  @@index([leaderId])
  @@index([status])
  @@index([psNumber])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  isLeader Boolean  @default(false) @map("is_leader")
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([teamId])
  @@index([userId])
  @@index([isLeader])
  @@map("team_members")
}

model EvaluatorAssignment {
  id          String   @id @default(uuid())
  teamId      String   @unique @map("team_id")
  evaluatorId String   @map("evaluator_id")
  assignedBy  String?  @map("assigned_by")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evaluator Profile @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([evaluatorId])
  @@map("evaluator_assignments")
}

model Evaluation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId         String   @map("team_id")
  evaluatorId    String   @map("evaluator_id")
  evaluatorEmail String?  @map("evaluator_email")
  novelty        Int
  technical      Int
  impact         Int
  presentation   Int
  totalScore     Int      @map("total_score")
  verdict        String
  remarks        String?
  waitlistReason String?  @map("waitlist_reason")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evaluator Profile @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([teamId, evaluatorId], name: "uq_team_evaluator")
  @@index([teamId])
  @@index([evaluatorId])
  @@map("evaluations")
}

model PortalSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("portal_settings")
}
